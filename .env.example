# Active AI provider: OpenRouter
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=google/gemma-4-31b-it:free
OPENROUTER_FALLBACK_MODEL=openrouter/free

# Legacy Gemini provider (disabled by default; used as fallback only if
# OPENROUTER_API_KEY is empty and this key is set)
# GEMINI_API_KEY=your_gemini_api_key
# GEMINI_MODEL=gemini-3.5-flash-lite

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# Your Telegram user ID (or a group/channel ID)
TELEGRAM_CHAT_ID=your_telegram_chat_id

# Optional settings
CHECK_INTERVAL_MINUTES=240
REQUEST_TIMEOUT_SECONDS=25
MAX_PAGES_PER_UNIVERSITY=5
MAX_AI_REQUESTS_PER_RUN=8
PLAYWRIGHT_FALLBACK=true
